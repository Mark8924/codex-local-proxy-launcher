# Copy this file to codex-proxy-launcher.env, then edit it if your proxy is
# not using the default v2rayN HTTP/mixed port.

CODEX_PROXY_PORT=10808
CODEX_PROXY_HOST=127.0.0.1
CODEX_PROXY_SCHEME=http

